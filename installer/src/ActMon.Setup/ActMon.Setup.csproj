<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\ActMon.Setup.Core\ActMon.Setup.Core.csproj" />
  </ItemGroup>

  <!-- Compiled into the assembly itself (pack://application:,,,/Assets/actmon-logo.png)
       — the installer never reads the logo from the original frontend/public path,
       so it still has it after packaging with no external file dependency. -->
  <ItemGroup>
    <Resource Include="Assets\actmon-logo.png" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>ActMon</AssemblyName>
    <ApplicationIcon>..\..\packaging\actmon-icon.ico</ApplicationIcon>
    <Product>ActMon</Product>
    <Company>ACTIN</Company>
    <AssemblyTitle>ActMon Setup</AssemblyTitle>
    <Description>ActMon Database &amp; Infrastructure Monitoring Platform — Setup</Description>
    <Version>1.1.0</Version>
    <FileVersion>1.1.0.0</FileVersion>
  </PropertyGroup>

  <!-- The UAC-elevation manifest only applies to Release builds — a Debug build
       stays launchable without a UAC prompt, since a real UAC prompt can't be
       approved non-interactively and would otherwise block every local dev/test
       run of the wizard. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <!-- Self-contained single-file settings apply only to `dotnet publish`, not
       `dotnet build` — keeping them out of the unconditional properties above
       means day-to-day Debug builds stay fast and don't restore/copy an entire
       runtime pack on every build. -->
  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

</Project>
