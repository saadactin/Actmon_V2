<Window x:Class="ActMon.Setup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ActMon.Setup"
        xmlns:shell="clr-namespace:ActMon.Setup.Shell"
        xmlns:pExisting="clr-namespace:ActMon.Setup.Pages.ExistingInstallation"
        mc:Ignorable="d"
        Title="ActMon Setup" Height="620" Width="920" MinHeight="560" MinWidth="820"
        WindowStartupLocation="CenterScreen" Icon="Assets/actmon-logo.png">
    <Window.DataContext>
        <shell:RootViewModel/>
    </Window.DataContext>

    <Grid Background="White">
        <!-- ActMon already installed -->
        <pExisting:ExistingInstallationPage DataContext="{Binding ExistingInstall}"
                                             Visibility="{Binding DataContext.IsExistingInstall, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>

        <!-- Fresh-install wizard -->
        <Grid DataContext="{Binding Wizard}"
              Visibility="{Binding DataContext.IsExistingInstall, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Step sidebar -->
                <Border Grid.Column="0" Background="#0F172A">
                    <StackPanel Margin="0,24,0,0">
                        <Image Source="Assets/actmon-logo.png" Height="48" Stretch="Uniform"
                               HorizontalAlignment="Center" Margin="0,0,0,20"/>
                        <ItemsControl ItemsSource="{Binding Steps}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="✓" Foreground="#22C55E" FontSize="11"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVis}}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Title}" Padding="4,6" FontSize="12.5"
                                                   TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#94A3B8"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                            <Setter Property="Foreground" Value="White"/>
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                            <Setter Property="Foreground" Value="#CBD5E1"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Current page -->
                <Border Grid.Column="1" Background="White" Padding="28">
                    <ContentControl Content="{Binding CurrentPage}"/>
                </Border>
            </Grid>

            <!-- Navigation bar -->
            <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="20,14">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Cancel" Command="{Binding CancelCommand}"
                            Width="90" Height="32" Margin="8,0,0,0"/>
                    <Button DockPanel.Dock="Right" Content="{Binding NextButtonLabel}" Command="{Binding NextCommand}"
                            Width="90" Height="32" Margin="8,0,0,0" Background="#2563EB" Foreground="White" FontWeight="SemiBold"/>
                    <Button DockPanel.Dock="Right" Content="Back" Command="{Binding BackCommand}"
                            Width="90" Height="32"/>
                    <TextBlock Text="" />
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
