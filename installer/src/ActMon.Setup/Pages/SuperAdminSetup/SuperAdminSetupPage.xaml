<UserControl x:Class="ActMon.Setup.Pages.SuperAdminSetup.SuperAdminSetupPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mvvm="clr-namespace:ActMon.Setup.Mvvm"
             mc:Ignorable="d" d:DesignWidth="640">
    <StackPanel Margin="8">
        <TextBlock Text="Super Administrator Setup" FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>

        <TextBlock Text="Checking for an existing Super Admin…" Foreground="#64748B" Margin="0,16,0,0"
                   Visibility="{Binding IsChecking, Converter={StaticResource BoolToVis}}"/>
        <TextBlock Text="{Binding ProbeError}" Foreground="#DC2626" TextWrapping="Wrap" Margin="0,16,0,0"
                   Visibility="{Binding ProbeError, Converter={StaticResource NullToVis}}"/>

        <StackPanel Visibility="{Binding AdminAlreadyExists, Converter={StaticResource BoolToVis}}" Margin="0,16,0,0">
            <TextBlock Foreground="#16A34A" FontWeight="SemiBold" TextWrapping="Wrap"
                       Text="✓ This database already has a Super Admin — this installer will not create another one or touch existing credentials."/>
        </StackPanel>

        <StackPanel Visibility="{Binding AdminAlreadyExists, Converter={StaticResource InverseBoolToVis}}">
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Full Name:" VerticalAlignment="Center" Margin="0,0,0,8"/>
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" Padding="4" Margin="0,0,0,8"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Email:" VerticalAlignment="Center" Margin="0,0,0,8"/>
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Padding="4" Margin="0,0,0,8"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Username:" VerticalAlignment="Center" Margin="0,0,0,8"/>
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Padding="4" Margin="0,0,0,8"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Password:" VerticalAlignment="Center" Margin="0,0,0,8"/>
                <PasswordBox Grid.Row="3" Grid.Column="1" Padding="4" Margin="0,0,0,8" mvvm:PasswordBoxBehavior.BindPassword="True"
                             mvvm:PasswordBoxBehavior.BoundPassword="{Binding Password, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Confirm Password:" VerticalAlignment="Center" Margin="0,0,0,8"/>
                <PasswordBox Grid.Row="4" Grid.Column="1" Padding="4" Margin="0,0,0,8" mvvm:PasswordBoxBehavior.BindPassword="True"
                             mvvm:PasswordBoxBehavior.BoundPassword="{Binding ConfirmPassword, UpdateSourceTrigger=PropertyChanged}"/>
            </Grid>

            <Button Content="Continue" Command="{Binding ConfirmCommand}" HorizontalAlignment="Left" Padding="14,6"
                    Visibility="{Binding Confirmed, Converter={StaticResource InverseBoolToVis}}"/>

            <TextBlock Text="{Binding ValidationError}" Foreground="#DC2626" TextWrapping="Wrap" Margin="0,10,0,0"
                       Visibility="{Binding ValidationError, Converter={StaticResource NullToVis}}"/>

            <TextBlock Text="✓ Confirmed" Foreground="#16A34A" FontWeight="SemiBold" Margin="0,10,0,0"
                       Visibility="{Binding Confirmed, Converter={StaticResource BoolToVis}}"/>
        </StackPanel>
    </StackPanel>
</UserControl>
