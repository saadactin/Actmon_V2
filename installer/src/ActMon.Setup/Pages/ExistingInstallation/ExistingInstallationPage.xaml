<UserControl x:Class="ActMon.Setup.Pages.ExistingInstallation.ExistingInstallationPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignWidth="820" d:DesignHeight="600">
    <Grid Background="White" Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <Image Source="/Assets/actmon-logo.png" Height="56" Stretch="Uniform"
                   HorizontalAlignment="Left" Margin="0,0,0,16"/>
            <TextBlock Text="ActMon is already installed" FontSize="24" FontWeight="Bold" Foreground="#0F172A"/>
            <TextBlock Foreground="#64748B" Margin="0,6,0,0">
                <Run Text="Version"/> <Run Text="{Binding Version, Mode=OneWay}"/>
                <Run Text=" · installed "/><Run Text="{Binding InstalledAt, Mode=OneWay}"/>
                <Run Text=" · "/><Run Text="{Binding InstallDirectory, Mode=OneWay}"/>
            </TextBlock>
        </StackPanel>

        <Border Grid.Row="1" Background="#F1F5F9" CornerRadius="6" Padding="14" Margin="0,20,0,20">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Organization:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding OrganizationName}" Margin="0,0,0,4"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="ActMon URL:" FontWeight="SemiBold"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ActMonUrl}"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <!-- Action buttons -->
            <StackPanel Visibility="{Binding ShowUninstallConfirm, Converter={StaticResource InverseBoolToVis}}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <Button Content="Modify" Command="{Binding ModifyCommand}" Padding="18,10" Margin="0,0,10,0" MinWidth="110"/>
                    <Button Content="Repair" Command="{Binding RepairCommand}" Padding="18,10" Margin="0,0,10,0" MinWidth="110"/>
                    <Button Content="Upgrade" Command="{Binding UpgradeCommand}" Padding="18,10" Margin="0,0,10,0" MinWidth="110"/>
                    <Button Content="Uninstall" Command="{Binding ShowUninstallCommand}" Padding="18,10" MinWidth="110" Background="#FEF2F2" Foreground="#991B1B"/>
                </StackPanel>

                <TextBlock Margin="0,16,0,0" Foreground="#64748B" TextWrapping="Wrap" MaxWidth="600">
                    <Run FontWeight="SemiBold" Text="Modify"/><Run Text=" — go through configuration again (install directory, ports, credentials, organization), pre-filled with what's already installed. "/>
                    <Run FontWeight="SemiBold" Text="Repair"/><Run Text=" — re-deploy files and re-create services/firewall rules without changing configuration. "/>
                    <Run FontWeight="SemiBold" Text="Upgrade"/><Run Text=" — same as Repair, using this download's files. "/>
                    <Run FontWeight="SemiBold" Text="Uninstall"/><Run Text=" — remove ActMon; your PostgreSQL/Redis/ClickHouse data is kept unless you separately choose to remove it."/>
                </TextBlock>
            </StackPanel>

            <!-- Uninstall confirmation -->
            <StackPanel Visibility="{Binding ShowUninstallConfirm, Converter={StaticResource BoolToVis}}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolToVis}}">
                <TextBlock Text="Remove ActMon?" FontSize="16" FontWeight="Bold" Foreground="#991B1B"/>
                <TextBlock Foreground="#64748B" Margin="0,6,0,14" TextWrapping="Wrap" MaxWidth="600"
                           Text="This stops and removes the ActMon Windows Services, firewall rules and deployed files. PostgreSQL, Redis and ClickHouse themselves are never touched."/>
                <CheckBox Content="Also remove ActMon's PostgreSQL and ClickHouse databases (cannot be undone)" IsChecked="{Binding AlsoRemoveData}" Margin="0,0,0,14"/>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Remove ActMon" Command="{Binding ConfirmUninstallCommand}" Padding="16,8" Margin="0,0,10,0" Background="#DC2626" Foreground="White" FontWeight="SemiBold"/>
                    <Button Content="Cancel" Command="{Binding CancelUninstallCommand}" Padding="16,8"/>
                </StackPanel>
            </StackPanel>

            <!-- Busy / progress -->
            <Border Background="#0F172A" CornerRadius="6" Padding="14" Margin="0,20,0,0" MaxHeight="220"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="{Binding BusyLabel}" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <ScrollViewer MaxHeight="170" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding ProgressLines}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Foreground="#4ADE80" FontFamily="Consolas" FontSize="12"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding DoneMessage}" Foreground="#16A34A" FontWeight="Bold" Margin="0,20,0,0"
                       Visibility="{Binding Done, Converter={StaticResource BoolToVis}}"/>
            <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC2626" TextWrapping="Wrap" Margin="0,20,0,0"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVis}}"/>
        </Grid>
    </Grid>
</UserControl>
