<UserControl x:Class="ActMon.Setup.Pages.Install.InstallPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignWidth="640">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <Image Source="/Assets/actmon-logo.png" Height="40" Stretch="Uniform"
                   HorizontalAlignment="Left" Margin="0,0,0,14"/>
            <TextBlock Text="Installing ActMon" FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
            <TextBlock Foreground="#64748B" Margin="0,4,0,0" TextWrapping="Wrap"
                       Text="Deploying files, writing configuration, provisioning the database, and creating Windows Services."/>
        </StackPanel>

        <Border Grid.Row="1" Background="#0F172A" CornerRadius="6" Padding="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding ProgressLines}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Foreground="#4ADE80" FontFamily="Consolas" FontSize="12.5" Margin="0,1"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="2" Margin="0,14,0,0">
            <TextBlock Text="✓ Installation completed successfully." Foreground="#16A34A" FontWeight="Bold"
                       Visibility="{Binding Succeeded, Converter={StaticResource BoolToVis}}"/>

            <Border Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="6" Padding="14"
                    Visibility="{Binding Failed, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock FontWeight="Bold" Foreground="#991B1B">
                        <Run Text="Component: "/><Run Text="{Binding ErrorComponent, Mode=OneWay}"/>
                    </TextBlock>
                    <TextBlock Foreground="#991B1B" Margin="0,4,0,0" TextWrapping="Wrap">
                        <Run Text="Problem: "/><Run Text="{Binding ErrorProblem, Mode=OneWay}"/>
                    </TextBlock>
                    <TextBlock Foreground="#991B1B" Margin="0,4,0,0" TextWrapping="Wrap">
                        <Run Text="Recommended Action: "/><Run Text="{Binding ErrorAction, Mode=OneWay}"/>
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="Retry" Command="{Binding RetryCommand}" Padding="12,5" Margin="0,0,8,0"/>
                        <Button Content="View Details" Command="{Binding ToggleDetailsCommand}" Padding="12,5"/>
                    </StackPanel>
                    <TextBox Text="{Binding ErrorDetails, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                             FontFamily="Consolas" FontSize="11" MaxHeight="150" Margin="0,10,0,0"
                             VerticalScrollBarVisibility="Auto"
                             Visibility="{Binding ShowDetails, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
