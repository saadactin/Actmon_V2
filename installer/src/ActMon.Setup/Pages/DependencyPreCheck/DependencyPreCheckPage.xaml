<UserControl x:Class="ActMon.Setup.Pages.DependencyPreCheck.DependencyPreCheckPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignWidth="640">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Dependency Pre-check" FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
            <TextBlock Foreground="#64748B" Margin="0,4,0,0" TextWrapping="Wrap"
                       Text="PostgreSQL and ClickHouse run as native Windows services; Redis runs inside WSL2 + Ubuntu (Redis has no supported native Windows build). Anything already installed is reused as-is — nothing here is reinstalled."/>
        </StackPanel>

        <Grid Grid.Row="1">
            <TextBlock Text="Detecting dependencies…" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#64748B" FontSize="14"/>

            <ItemsControl ItemsSource="{Binding Rows}" Visibility="{Binding IsBusy, Converter={StaticResource InverseBoolToVis}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding StatusGlyph}" FontSize="20" FontWeight="Bold"
                                           Foreground="{Binding StatusBrushKey, Converter={StaticResource BrushKeyConverter}}"
                                           VerticalAlignment="Top" Margin="0,0,12,0"/>
                                <StackPanel Grid.Column="1">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"/>
                                        <TextBlock Text="{Binding StatusLabel}" Margin="10,0,0,0" FontSize="12"
                                                   Foreground="{Binding StatusBrushKey, Converter={StaticResource BrushKeyConverter}}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Details}" Foreground="#475569" TextWrapping="Wrap" Margin="0,4,0,0" FontSize="12.5"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Grid>
</UserControl>
