<UserControl x:Class="ActMon.Setup.Pages.OrganizationSetup.OrganizationSetupPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignWidth="640">
    <StackPanel Margin="8">
        <TextBlock Text="Organization Setup" FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>

        <TextBlock Text="Checking the target database for an existing organization…" Foreground="#64748B" Margin="0,16,0,0"
                   Visibility="{Binding IsChecking, Converter={StaticResource BoolToVis}}"/>

        <TextBlock Text="{Binding ProbeError}" Foreground="#DC2626" TextWrapping="Wrap" Margin="0,16,0,0"
                   Visibility="{Binding ProbeError, Converter={StaticResource NullToVis}}"/>

        <!-- Existing organization found -->
        <StackPanel Visibility="{Binding SchemaHasOrganization, Converter={StaticResource BoolToVis}}" Margin="0,16,0,0">
            <TextBlock Foreground="#64748B" Margin="0,0,0,10" TextWrapping="Wrap"
                       Text="This database was already provisioned for ActMon and already has an organization:"/>
            <TextBlock Text="{Binding ExistingOrgName}" FontSize="16" FontWeight="Bold" Margin="0,0,0,14"/>
            <Button Content="Use this organization" Command="{Binding ConfirmExistingCommand}" HorizontalAlignment="Left" Padding="14,6"
                    Visibility="{Binding ExistingConfirmed, Converter={StaticResource InverseBoolToVis}}"/>
            <TextBlock Text="✓ Confirmed" Foreground="#16A34A" FontWeight="SemiBold" Margin="0,10,0,0"
                       Visibility="{Binding ExistingConfirmed, Converter={StaticResource BoolToVis}}"/>
        </StackPanel>

        <!-- Fresh database — needs a name -->
        <StackPanel Visibility="{Binding SchemaHasOrganization, Converter={StaticResource InverseBoolToVis}}" Margin="0,16,0,0">
            <StackPanel Visibility="{Binding IsChecking, Converter={StaticResource InverseBoolToVis}}">
                <TextBlock Foreground="#64748B" Margin="0,0,0,10" TextWrapping="Wrap"
                           Text="This is a fresh installation — name the organization ActMon will monitor for."/>
                <TextBlock Text="Organization Name:" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBox Text="{Binding NewOrgName, UpdateSourceTrigger=PropertyChanged}" Padding="6" Width="320" HorizontalAlignment="Left"/>

                <Button Content="Continue" Command="{Binding ConfirmNewCommand}" HorizontalAlignment="Left" Padding="14,6" Margin="0,12,0,0"
                        Visibility="{Binding NewConfirmed, Converter={StaticResource InverseBoolToVis}}"/>

                <TextBlock Text="{Binding ValidationError}" Foreground="#DC2626" TextWrapping="Wrap" Margin="0,10,0,0"
                           Visibility="{Binding ValidationError, Converter={StaticResource NullToVis}}"/>

                <StackPanel Visibility="{Binding NewConfirmed, Converter={StaticResource BoolToVis}}" Margin="0,10,0,0">
                    <TextBlock Margin="0,0,0,0">
                        <Run Text="Organization: " FontWeight="SemiBold"/><Run Text="{Binding NewOrgName, Mode=OneWay}"/>
                    </TextBlock>
                    <TextBlock Text="✓ Confirmed" Foreground="#16A34A" FontWeight="SemiBold" Margin="0,6,0,0"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </StackPanel>
</UserControl>
