<UserControl x:Class="ActMon.Setup.Pages.WindowsServices.WindowsServicesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignWidth="640">
    <StackPanel Margin="8">
        <TextBlock Text="Windows Services" FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
        <TextBlock Foreground="#64748B" Margin="0,4,0,16" TextWrapping="Wrap"
                   Text="Verifying each ActMon component was registered and started as a Windows Service."/>

        <TextBlock Text="Checking…" Visibility="{Binding IsChecking, Converter={StaticResource BoolToVis}}" Foreground="#64748B"/>

        <ItemsControl ItemsSource="{Binding Rows}" Visibility="{Binding IsChecking, Converter={StaticResource InverseBoolToVis}}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                                <TextBlock Foreground="#64748B" FontSize="12" Margin="0,2,0,0">
                                    <Run Text="Startup type: "/><Run Text="{Binding StartupType, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBlock Text="✓ Service exists" Foreground="#16A34A" Margin="0,0,12,0" FontSize="12.5"
                                           Visibility="{Binding Exists, Converter={StaticResource BoolToVis}}"/>
                                <TextBlock Text="✕ Not found" Foreground="#DC2626" Margin="0,0,12,0" FontSize="12.5"
                                           Visibility="{Binding Exists, Converter={StaticResource InverseBoolToVis}}"/>
                                <TextBlock Text="✓ Running" Foreground="#16A34A" FontSize="12.5"
                                           Visibility="{Binding Running, Converter={StaticResource BoolToVis}}"/>
                                <TextBlock Text="✕ Not running" Foreground="#DC2626" FontSize="12.5"
                                           Visibility="{Binding Running, Converter={StaticResource InverseBoolToVis}}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
