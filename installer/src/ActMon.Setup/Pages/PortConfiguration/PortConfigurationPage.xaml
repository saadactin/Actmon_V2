<UserControl x:Class="ActMon.Setup.Pages.PortConfiguration.PortConfigurationPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ActMon.Setup.Pages.PortConfiguration"
             mc:Ignorable="d" d:DesignWidth="640">
    <UserControl.Resources>
        <DataTemplate DataType="{x:Type local:PortRowViewModel}">
            <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="240"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Label}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding Port, UpdateSourceTrigger=LostFocus}"
                             VerticalAlignment="Center" Padding="4" HorizontalContentAlignment="Center"/>
                    <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#16A34A"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                        <Setter Property="Foreground" Value="#DC2626"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsOwnService}" Value="True">
                                        <Setter Property="Foreground" Value="#D97706"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                        <Run Text="{Binding StatusText, Mode=OneWay}"/>
                    </TextBlock>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel Margin="8">
        <TextBlock Text="Port Configuration" FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
        <TextBlock Foreground="#64748B" Margin="0,4,0,20" TextWrapping="Wrap"
                   Text="ActMon needs these three ports. Nothing occupying a port is ever stopped automatically — change the port instead if there's a conflict."/>

        <ContentControl Content="{Binding Frontend}"/>
        <ContentControl Content="{Binding DatabaseBackend}"/>
        <ContentControl Content="{Binding CloudBackend}"/>

        <TextBlock Text="Network Access" FontSize="15" FontWeight="Bold" Margin="0,20,0,4"/>
        <TextBlock Foreground="#64748B" Margin="0,0,0,10" TextWrapping="Wrap"
                   Text="Frontend/nginx binds every network interface by default, so it's already reachable from other machines once the firewall allows it. Turn this off to restrict it to this machine only."/>

        <CheckBox Content="Allow access from other machines on the network" IsChecked="{Binding AllowRemoteAccess}" Margin="0,0,0,10"/>

        <StackPanel Visibility="{Binding AllowRemoteAccess, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="Public/LAN IP or hostname (shown in shortcuts and the summary — optional)" Margin="0,0,0,4"/>
            <TextBox Text="{Binding PublicHostOrIp, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" HorizontalAlignment="Left" MinWidth="260"/>
            <TextBlock Margin="0,4,0,0" FontSize="11.5" Foreground="#94A3B8" TextWrapping="Wrap"
                       Text="A likely local address is pre-filled — change it to whatever address other machines should actually use (a LAN IP, a public IP, or a hostname). Leave blank to just show &quot;localhost&quot;."/>
        </StackPanel>
    </StackPanel>
</UserControl>
