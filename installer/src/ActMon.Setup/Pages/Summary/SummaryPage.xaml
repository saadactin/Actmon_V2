<UserControl x:Class="ActMon.Setup.Pages.Summary.SummaryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignWidth="640">
    <UserControl.Resources>
        <Style x:Key="GroupTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Margin" Value="0,16,0,6"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="Margin" Value="0,0,10,4"/>
        </Style>
        <Style x:Key="Value" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="8">
            <TextBlock Text="{Binding Heading}" FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
            <TextBlock Text="{Binding Subheading}" Foreground="#64748B" Margin="0,4,0,0" TextWrapping="Wrap"/>

            <TextBlock Text="System" Style="{StaticResource GroupTitle}"/>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition/></Grid.RowDefinitions>
                <TextBlock Grid.Column="0" Text="Install directory:" Style="{StaticResource Label}"/>
                <TextBlock Grid.Column="1" Text="{Binding InstallDirectory}" Style="{StaticResource Value}"/>
            </Grid>

            <TextBlock Text="PostgreSQL" Style="{StaticResource GroupTitle}"/>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Host:" Style="{StaticResource Label}"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding PostgresHost}" Style="{StaticResource Value}"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Port:" Style="{StaticResource Label}"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PostgresPort}" Style="{StaticResource Value}"/>
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Database:" Style="{StaticResource Label}"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding PostgresDatabase}" Style="{StaticResource Value}"/>
                <TextBlock Grid.Row="3" Grid.Column="0" Text="Username:" Style="{StaticResource Label}"/>
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding PostgresUsername}" Style="{StaticResource Value}"/>
            </Grid>

            <TextBlock Text="Redis" Style="{StaticResource GroupTitle}"/>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Host:" Style="{StaticResource Label}"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding RedisHost}" Style="{StaticResource Value}"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Port:" Style="{StaticResource Label}"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding RedisPort}" Style="{StaticResource Value}"/>
            </Grid>

            <TextBlock Text="ClickHouse" Style="{StaticResource GroupTitle}"/>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Host:" Style="{StaticResource Label}"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ClickHouseHost}" Style="{StaticResource Value}"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Port:" Style="{StaticResource Label}"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ClickHousePort}" Style="{StaticResource Value}"/>
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Database:" Style="{StaticResource Label}"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ClickHouseDatabase}" Style="{StaticResource Value}"/>
                <TextBlock Grid.Row="3" Grid.Column="0" Text="Username:" Style="{StaticResource Label}"/>
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ClickHouseUsername}" Style="{StaticResource Value}"/>
            </Grid>

            <TextBlock Text="Organization" Style="{StaticResource GroupTitle}"/>
            <TextBlock Text="{Binding OrganizationName}" Style="{StaticResource Value}"/>

            <TextBlock Text="Super Admin" Style="{StaticResource GroupTitle}"/>
            <TextBlock Text="{Binding SuperAdminStatusText}" Style="{StaticResource Value}"/>

            <TextBlock Text="ActMon" Style="{StaticResource GroupTitle}"/>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Frontend:" Style="{StaticResource Label}"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding FrontendPort}" Style="{StaticResource Value}"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Database Backend:" Style="{StaticResource Label}"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DatabaseBackendPort}" Style="{StaticResource Value}"/>
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Cloud Backend:" Style="{StaticResource Label}"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CloudBackendPort}" Style="{StaticResource Value}"/>
                <TextBlock Grid.Row="3" Grid.Column="0" Text="Network access:" Style="{StaticResource Label}"/>
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding NetworkAccess}" Style="{StaticResource Value}"/>
                <TextBlock Grid.Row="4" Grid.Column="0" Text="ActMon URL:" Style="{StaticResource Label}"/>
                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ActMonUrl}" Style="{StaticResource Value}"/>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
