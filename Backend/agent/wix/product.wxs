<?xml version="1.0" encoding="UTF-8"?>
<!-- Production ActMon Agent MSI.
     - Installs actmon-agent.exe to C:\Program Files\ActMon (user-choosable via the wizard)
     - Stores Server URL + Token in HKLM\SOFTWARE\ActMon\Agent
     - Registers a Windows SERVICE (ActMonAgent), auto-start (unless declined in the
       wizard), LocalSystem
     - Configures the service to restart on failure
     - Starts the service immediately (unless declined); stops+removes it on uninstall
     - Full interactive wizard (Welcome / License / Permissions / Install Dir / Verify /
       Progress / Finish) when run without /qn; still supports silent install
       (msiexec /qn), upgrade, repair, clean uninstall
     Token/URL are baked at build time (candle -dToken=... -dUrl=...); still
     overridable on the command line: msiexec /i actmon-agent.msi ACCESS_TOKEN=.. ACTMON_URL=.. -->
<?ifndef Token ?><?define Token = "" ?><?endif ?>
<?ifndef Url ?><?define Url = "" ?><?endif ?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi"
     xmlns:util="http://schemas.microsoft.com/wix/UtilExtension">
  <Product Id="*" Name="ActMon Agent" Language="1033" Version="1.1.2.0"
           Manufacturer="ActMon" UpgradeCode="A1B2C3D4-1111-2222-3333-444455556666">
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perMachine"
             Description="ActMon Host Monitoring Agent" Manufacturer="ActMon" />

    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of ActMon Agent is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!-- Defaults baked at build time; overridable on the msiexec command line.
         When no token/url is baked (base build) the properties are left unset
         so WiX doesn't reject an empty Value attribute. -->
    <?if "$(var.Token)" != "" ?>
    <Property Id="ACCESS_TOKEN" Value="$(var.Token)" Secure="yes" />
    <?else?>
    <Property Id="ACCESS_TOKEN" Secure="yes" />
    <?endif?>
    <?if "$(var.Url)" != "" ?>
    <Property Id="ACTMON_URL" Value="$(var.Url)" Secure="yes" />
    <?else?>
    <Property Id="ACTMON_URL" Secure="yes" />
    <?endif?>

    <!-- Wizard-only choices (default to the previous, always-on behavior — a
         silent/unattended msiexec /qn install, which never visits the
         Permissions dialog, still gets exactly today's behavior).
         PERM_* mirror Backend/database/app/services/agent/agent_permissions.py's
         PERMISSION_CATALOG one-for-one — keep both in sync if that ever changes.
         Defaults here match that catalog's `default` column. -->
    <!-- Secure="yes" is required (not just cosmetic) for every one of these:
         it's what lets a value SET on the msiexec command line (the .bat/.ps1
         generated installers now pass PERM_X="1"/"" there, same mechanism
         ACCESS_TOKEN/ACTMON_URL already use below) survive from the
         UI/immediate sequence into the deferred sequence where the actual
         registry write below runs. Without it, a command-line override would
         be silently ignored and the registry would always get the built-in
         default instead. -->
    <Property Id="STARTSERVICE" Value="1" />
    <Property Id="PERM_HOSTMON" Value="1" Secure="yes" />
    <Property Id="PERM_DBACCESS" Value="1" Secure="yes" />
    <Property Id="PERM_DIAG" Value="1" Secure="yes" />
    <Property Id="PERM_CMD" Value="1" Secure="yes" />
    <Property Id="PERM_PROCCTRL" Value="1" Secure="yes" />
    <Property Id="PERM_SVCCTRL" Value="1" Secure="yes" />
    <Property Id="PERM_SELFUPDATE" Value="1" Secure="yes" />
    <!-- No Value attribute = undefined/blank by default (WiX rejects an
         explicit empty string) — same runtime effect: off unless checked or
         set on the command line. -->
    <Property Id="PERM_FILEWRITE" Secure="yes" />
    <Property Id="PERM_FWCTRL" Secure="yes" />
    <Property Id="PERM_REBOOT" Secure="yes" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="ActMon" />
      </Directory>
    </Directory>

    <ComponentGroup Id="AgentComponents" Directory="INSTALLFOLDER">
      <!-- The agent exe + the Windows service definition. -->
      <Component Id="AgentExe" Guid="*">
        <File Id="ActMonAgentExe" Source="$(var.AgentExe)" KeyPath="yes" Name="actmon-agent.exe" />

        <ServiceInstall Id="ActMonServiceInstall"
                        Name="ActMonAgent"
                        DisplayName="ActMon Monitoring Agent"
                        Description="Collects host metrics/inventory and reports them to the ActMon server."
                        Type="ownProcess"
                        Start="auto"
                        ErrorControl="normal"
                        Account="LocalSystem"
                        Vital="yes">
          <!-- Restart the service on the 1st, 2nd, and subsequent failures. -->
          <util:ServiceConfig FirstFailureActionType="restart"
                              SecondFailureActionType="restart"
                              ThirdFailureActionType="restart"
                              RestartServiceDelayInSeconds="30"
                              ResetPeriodInDays="1" />
        </ServiceInstall>

        <!-- Always start on install — if the wizard's "start automatically"
             box was unchecked, StopAgentServiceIfDeclined (below) stops it
             again immediately after, since ServiceControl itself has no
             Condition support in WiX 3's schema. Stop on uninstall either
             way; remove on uninstall. -->
        <ServiceControl Id="ActMonServiceControl"
                        Name="ActMonAgent"
                        Start="install"
                        Stop="both"
                        Remove="uninstall"
                        Wait="no" />
      </Component>

      <!-- Server URL + token + the wizard's host-monitoring choice in the
           registry (the service reads these on start). -->
      <Component Id="AgentConfig" Guid="*">
        <RegistryKey Root="HKLM" Key="SOFTWARE\ActMon\Agent">
          <RegistryValue Type="string" Name="Token" Value="[ACCESS_TOKEN]" KeyPath="yes" />
          <RegistryValue Type="string" Name="Url" Value="[ACTMON_URL]" />
          <!-- One flat value per catalog key (actmon_agent.py's
               _WIN_REG_PERM_NAMES) — every current install writes all ten,
               which is exactly what lets the agent tell "an install from
               before this feature existed" (none of these present) apart
               from "every permission was explicitly declined" (present, all
               empty). -->
          <RegistryValue Type="string" Name="Perm_HostMonitoring" Value="[PERM_HOSTMON]" />
          <RegistryValue Type="string" Name="Perm_DatabaseAccess" Value="[PERM_DBACCESS]" />
          <RegistryValue Type="string" Name="Perm_RemoteDiagnostics" Value="[PERM_DIAG]" />
          <RegistryValue Type="string" Name="Perm_RemoteCommand" Value="[PERM_CMD]" />
          <RegistryValue Type="string" Name="Perm_ProcessControl" Value="[PERM_PROCCTRL]" />
          <RegistryValue Type="string" Name="Perm_ServiceControl" Value="[PERM_SVCCTRL]" />
          <RegistryValue Type="string" Name="Perm_SelfUpdate" Value="[PERM_SELFUPDATE]" />
          <RegistryValue Type="string" Name="Perm_RemoteFileWrite" Value="[PERM_FILEWRITE]" />
          <RegistryValue Type="string" Name="Perm_FirewallControl" Value="[PERM_FWCTRL]" />
          <RegistryValue Type="string" Name="Perm_Reboot" Value="[PERM_REBOOT]" />
        </RegistryKey>
      </Component>
    </ComponentGroup>

    <Feature Id="MainFeature" Title="ActMon Agent" Level="1">
      <ComponentGroupRef Id="AgentComponents" />
    </Feature>

    <!-- If the wizard's "start automatically" checkbox was unchecked, stop
         the service right after it's started (ServiceControl above has no
         Condition support, so this is the supported way to make that
         checkbox actually do something) — sc.exe stop is a no-op/harmless
         if the service isn't running. A silent (/qn) install never touches
         this (STARTSERVICE defaults to "1"), so today's always-start
         behavior is unchanged unless the wizard's checkbox is used. -->
    <CustomAction Id="SetStopAgentServiceCmd" Property="StopAgentServiceIfDeclined"
                  Value="&quot;[SystemFolder]sc.exe&quot; stop ActMonAgent" />
    <CustomAction Id="StopAgentServiceIfDeclined" BinaryKey="WixCA" DllEntry="CAQuietExec"
                  Execute="deferred" Return="ignore" Impersonate="no" />
    <InstallExecuteSequence>
      <Custom Action="SetStopAgentServiceCmd" Before="StopAgentServiceIfDeclined">NOT STARTSERVICE = "1" AND NOT Installed</Custom>
      <Custom Action="StopAgentServiceIfDeclined" After="StartServices">NOT STARTSERVICE = "1" AND NOT Installed</Custom>
    </InstallExecuteSequence>

    <!-- ── Wizard UI ──────────────────────────────────────────────────────────
         Welcome -> License -> Permissions (custom) -> Install Dir -> Verify
         Ready -> Progress -> Finish, with working Back/Next/Cancel throughout.
         A silent run (msiexec /qn) never shows any of this and gets the
         Property defaults above (service starts, host monitoring on) — same
         as before this UI existed. -->
    <UIRef Id="WixUI_InstallDir" />
    <UIRef Id="WixUI_ErrorProgressText" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)" />
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />

    <UI>
      <!-- Server URL + Token are editable here (not just command-line
           overrides) so a plain double-click of the UNCONFIGURED MSI —
           downloaded straight from the server, no per-token server-side
           rebuild involved — can still be fully self-service. If they were
           supplied via msiexec ACCESS_TOKEN=/ACTMON_URL= (the .bat/.ps1/
           one-liner deploy paths) or baked in at build time, these fields
           just start pre-filled and the user can skip straight past them. -->
      <Dialog Id="PermissionsDlg" Width="370" Height="460" Title="!(loc.InstallDirDlg_Title)">
        <Control Id="Title" Type="Text" X="15" Y="6" Width="250" Height="15" Transparent="yes" NoPrefix="yes"
                 Text="ActMon Agent Configuration" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="320" Height="15" Transparent="yes" NoPrefix="yes"
                 Text="Confirm where this agent reports to, then choose its permissions." />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />

        <Control Id="FindValuesNote" Type="Text" X="25" Y="52" Width="320" Height="20" Transparent="yes" NoPrefix="yes"
                 Text="Find both of these in ActMon under Agents -&gt; Add Agent - or cancel and use the pre-configured .bat installer instead, which needs neither typed in." />

        <Control Id="ServerUrlLabel" Type="Text" X="25" Y="75" Width="320" Height="10" Transparent="yes" NoPrefix="yes"
                 Text="ActMon Server URL:" />
        <Control Id="ServerUrlEdit" Type="Edit" X="25" Y="87" Width="320" Height="18" Property="ACTMON_URL" />

        <Control Id="TokenLabel" Type="Text" X="25" Y="109" Width="320" Height="10" Transparent="yes" NoPrefix="yes"
                 Text="Enrollment Token:" />
        <!-- Password="yes" masks it on screen — the token is a bearer
             credential (anyone who has it can enroll a host against this
             server), so it's treated the same as any other secret field
             rather than shown in plaintext while being typed. -->
        <Control Id="TokenEdit" Type="Edit" X="25" Y="121" Width="320" Height="18" Property="ACCESS_TOKEN" Password="yes" />

        <Control Id="MidLine" Type="Line" X="0" Y="146" Width="370" Height="0" />

        <Control Id="StartServiceCheckBox" Type="CheckBox" X="25" Y="154" Width="320" Height="18"
                 Property="STARTSERVICE" CheckBoxValue="1"
                 Text="Start the ActMon Agent service automatically after installation" />
        <Control Id="StartServiceNote" Type="Text" X="40" Y="171" Width="305" Height="22" Transparent="yes" NoPrefix="yes"
                 Text="Runs as LocalSystem, starts at boot, and restarts itself if it ever stops." />

        <!-- Permission list — mirrors agent_permissions.PERMISSION_CATALOG one
             for one. Defaults (which start checked) match that catalog's
             `default` column: everything with a confirmed existing consumer
             in the app is on, so a normal install regresses nothing already
             shipped; the last three (off by default) had no confirmed
             consumer, or (Reboot) are split out deliberately given their
             blast radius — see agent_permissions.py's module docstring. -->
        <Control Id="PermHostMonCheckBox" Type="CheckBox" X="25" Y="198" Width="320" Height="16"
                 Property="PERM_HOSTMON" CheckBoxValue="1"
                 Text="Host Monitoring (CPU, memory, disk)" />
        <Control Id="PermDbAccessCheckBox" Type="CheckBox" X="25" Y="216" Width="320" Height="16"
                 Property="PERM_DBACCESS" CheckBoxValue="1"
                 Text="Database Access (agent-proxied DB queries &amp; maintenance)" />
        <Control Id="PermDiagCheckBox" Type="CheckBox" X="25" Y="234" Width="320" Height="16"
                 Property="PERM_DIAG" CheckBoxValue="1"
                 Text="Remote Diagnostics &amp; File Read" />
        <Control Id="PermCmdCheckBox" Type="CheckBox" X="25" Y="252" Width="320" Height="16"
                 Property="PERM_CMD" CheckBoxValue="1"
                 Text="Remote Command Execution" />
        <Control Id="PermProcCtrlCheckBox" Type="CheckBox" X="25" Y="270" Width="320" Height="16"
                 Property="PERM_PROCCTRL" CheckBoxValue="1"
                 Text="Process Control (kill a process)" />
        <Control Id="PermSvcCtrlCheckBox" Type="CheckBox" X="25" Y="288" Width="320" Height="16"
                 Property="PERM_SVCCTRL" CheckBoxValue="1"
                 Text="Service Control (start/stop/restart)" />
        <Control Id="PermSelfUpdateCheckBox" Type="CheckBox" X="25" Y="306" Width="320" Height="16"
                 Property="PERM_SELFUPDATE" CheckBoxValue="1"
                 Text="Agent Self-Update" />
        <Control Id="PermFileWriteCheckBox" Type="CheckBox" X="25" Y="324" Width="320" Height="16"
                 Property="PERM_FILEWRITE" CheckBoxValue="1"
                 Text="Remote File Write" />
        <Control Id="PermFwCtrlCheckBox" Type="CheckBox" X="25" Y="342" Width="320" Height="16"
                 Property="PERM_FWCTRL" CheckBoxValue="1"
                 Text="Firewall Control" />
        <Control Id="PermRebootCheckBox" Type="CheckBox" X="25" Y="360" Width="320" Height="16"
                 Property="PERM_REBOOT" CheckBoxValue="1"
                 Text="Remote Reboot (restarts the whole host — off by default)" />

        <Control Id="BottomLine" Type="Line" X="0" Y="424" Width="370" Height="0" />
        <Control Id="Back" Type="PushButton" X="180" Y="433" Width="56" Height="17" Text="!(loc.WixUIBack)">
          <Publish Event="NewDialog" Value="LicenseAgreementDlg">1</Publish>
        </Control>
        <Control Id="Next" Type="PushButton" X="236" Y="433" Width="56" Height="17" Default="yes" Text="!(loc.WixUINext)">
          <Publish Event="NewDialog" Value="InstallDirDlg">1</Publish>
          <!-- Disabled until a Server URL is entered — the one field this
               agent genuinely cannot run without. Token is left optional
               here (blank is a valid, if useless, install) rather than
               hard-blocking on it. -->
          <Condition Action="disable">ACTMON_URL = ""</Condition>
          <Condition Action="enable">ACTMON_URL &lt;&gt; ""</Condition>
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="433" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg">1</Publish>
        </Control>
      </Dialog>

      <!-- Splice PermissionsDlg in between the standard License and Install
           Dir dialogs — ALWAYS, even when Server URL/Token are already
           supplied (baked at build time, or via msiexec ACCESS_TOKEN=/
           ACTMON_URL= command-line overrides, which is how every generated
           install command — .bat/.ps1/one-liner — runs it). Those two fields
           simply arrive pre-filled in that case; the permission checkboxes
           still need a real screen to be reviewed/changed on THIS machine,
           by whoever is actually running the installer — which may not be
           the same person who generated the link in the web wizard. Command-
           line PERM_* overrides (when the .bat/.ps1 supplied them) still land
           as this screen's pre-checked defaults; nothing here overrides a
           silent /qn install, which never shows any UI at all. -->
      <Publish Dialog="LicenseAgreementDlg" Control="Next" Event="NewDialog" Value="PermissionsDlg">LicenseAccepted = "1"</Publish>
      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="PermissionsDlg">1</Publish>
    </UI>
  </Product>
</Wix>
