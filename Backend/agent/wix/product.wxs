<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*" Name="ActMon Agent" Language="1033" Version="1.0.0.0"
           Manufacturer="ActMon" UpgradeCode="A1B2C3D4-1111-2222-3333-444455556666">
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perMachine"
             Description="ActMon Host Monitoring Agent" Manufacturer="ActMon" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of ActMon Agent is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!-- Passed on the command line: msiexec /i actmon-agent.msi ACCESS_TOKEN=... ACTMON_URL=... -->
    <Property Id="ACCESS_TOKEN" Secure="yes" />
    <Property Id="ACTMON_URL" Secure="yes" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="CommonAppDataFolder">
        <Directory Id="INSTALLFOLDER" Name="ActMon" />
      </Directory>
    </Directory>

    <ComponentGroup Id="AgentComponents" Directory="INSTALLFOLDER">
      <Component Id="AgentExe" Guid="*">
        <File Id="ActMonAgentExe" Source="$(var.AgentExe)" KeyPath="yes" Name="actmon-agent.exe" />
      </Component>
      <Component Id="AgentConfig" Guid="*">
        <RegistryKey Root="HKLM" Key="SOFTWARE\ActMon\Agent">
          <RegistryValue Type="string" Name="Token" Value="[ACCESS_TOKEN]" KeyPath="yes" />
          <RegistryValue Type="string" Name="Url" Value="[ACTMON_URL]" />
        </RegistryKey>
      </Component>
    </ComponentGroup>

    <Feature Id="MainFeature" Title="ActMon Agent" Level="1">
      <ComponentGroupRef Id="AgentComponents" />
    </Feature>

    <!-- ── Scheduled-task lifecycle via WixQuietExec (deferred, runs as SYSTEM) ── -->
    <CustomAction Id="SetCreateTask" Property="CreateTask"
      Value="schtasks.exe /create /tn ActMonAgent /tr &quot;[INSTALLFOLDER]actmon-agent.exe&quot; /sc onstart /ru SYSTEM /rl HIGHEST /f" />
    <CustomAction Id="CreateTask" BinaryKey="WixCA" DllEntry="WixQuietExec"
      Execute="deferred" Impersonate="no" Return="ignore" />

    <CustomAction Id="SetRunTask" Property="RunTask" Value="schtasks.exe /run /tn ActMonAgent" />
    <CustomAction Id="RunTask" BinaryKey="WixCA" DllEntry="WixQuietExec"
      Execute="deferred" Impersonate="no" Return="ignore" />

    <CustomAction Id="SetKillProc" Property="KillProc" Value="taskkill.exe /im actmon-agent.exe /f" />
    <CustomAction Id="KillProc" BinaryKey="WixCA" DllEntry="WixQuietExec"
      Execute="deferred" Impersonate="no" Return="ignore" />

    <CustomAction Id="SetDeleteTask" Property="DeleteTask" Value="schtasks.exe /delete /tn ActMonAgent /f" />
    <CustomAction Id="DeleteTask" BinaryKey="WixCA" DllEntry="WixQuietExec"
      Execute="deferred" Impersonate="no" Return="ignore" />

    <InstallExecuteSequence>
      <!-- Uninstall: stop the process and remove the task before files are removed -->
      <Custom Action="SetKillProc" Before="KillProc">REMOVE="ALL"</Custom>
      <Custom Action="KillProc" Before="RemoveFiles">REMOVE="ALL"</Custom>
      <Custom Action="SetDeleteTask" After="KillProc">REMOVE="ALL"</Custom>
      <Custom Action="DeleteTask" Before="RemoveFiles">REMOVE="ALL"</Custom>

      <!-- Install: create the task then run it immediately -->
      <Custom Action="SetCreateTask" After="InstallFiles">NOT Installed</Custom>
      <Custom Action="CreateTask" After="SetCreateTask">NOT Installed</Custom>
      <Custom Action="SetRunTask" After="CreateTask">NOT Installed</Custom>
      <Custom Action="RunTask" After="SetRunTask">NOT Installed</Custom>
    </InstallExecuteSequence>
  </Product>
</Wix>
