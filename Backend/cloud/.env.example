# Cloud Discovery Service config. Copy to `.env` and fill in before running.
# When running via the repo-root docker-compose.yml, DATABASE_URL/DB_* here
# are overridden to point at the postgres container automatically — only
# the secrets below actually matter for a Docker Compose run.

CLOUD_SERVICE_PORT=8001
DEBUG=false

# Independent from Backend/database/.env's own JWT_SECRET/ACTMON_ENCRYPTION_KEY
# — this service has its own. Generate fresh values, never reuse an example:
#   python -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
JWT_SECRET=
# Fernet key specifically (32 url-safe base64 bytes):
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
ACTMON_ENCRYPTION_KEY=

# Only used when running this service OUTSIDE Docker Compose (e.g. directly
# via uvicorn on your own machine) — compose overrides these to point at the
# postgres container.
DATABASE_URL=postgresql://actmon:change-me@localhost:5432/actmon
DB_USER=actmon
DB_PASS=change-me
DB_HOST=localhost
DB_PORT=5432
DB_NAME=actmon
