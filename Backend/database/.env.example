# ─────────────────────────────────────────────────────────────
# ActMon configuration.  Copy to `.env` and edit before installing:
#     cp .env.example .env        (Linux/macOS)
#     copy .env.example .env      (Windows)
# The installer reads these values (it does NOT prompt).
# ─────────────────────────────────────────────────────────────

# PostgreSQL connection (a superuser role is needed at install time so the
# installer can CREATE DATABASE and set up extensions/triggers).
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=change-me
DB_NAME=actmon

# Organization + admin identity used to seed the baseline tenant.
# The Super Admin employee + user themselves are created in the first-run wizard.
ORG_NAME=Your Company
ADMIN_EMAIL=admin@yourcompany.com

# Security. CHANGE JWT_SECRET before going to production.
JWT_SECRET=change-me-in-production

# Master key for CredentialEncryptionService (app/services/common/credential_encryption_service.py) —
# encrypts EVERY credential ActMon stores at rest: database passwords, SSH
# passwords, agent DB-target passwords, SMTP passwords, cloud provider keys.
# REQUIRED — there is no fallback. If unset (or not valid base64 for 32
# bytes), the app raises a clear error at first use rather than silently
# generating a throwaway key or falling back to plaintext. Generate once with:
#   python -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
# Back up this value somewhere safe outside the DB — losing it makes every
# encrypted credential permanently unrecoverable.
ACTMON_ENCRYPTION_KEY=

# AI features (optional) — leave blank to disable.
GROQ_API_KEY=

# SMTP for login OTP + alert emails (optional at install; required for OTP login).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# SSH account ActMon's own MySQL config/health/service-restart helpers use on
# the monitored host (a dedicated maintenance account, separate from any
# per-connection SSH credentials). Optional — defaults match the account this
# app has always shipped with; set these to override/rotate it.
ACTMON_MYSQL_SSH_USERNAME=
ACTMON_MYSQL_SSH_PASSWORD=
