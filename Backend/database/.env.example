# ─────────────────────────────────────────────────────────────
# ActMon configuration.  Copy to `.env` and edit before installing:
#     cp .env.example .env        (Linux/macOS)
#     copy .env.example .env      (Windows)
# The installer reads these values (it does NOT prompt).
# ─────────────────────────────────────────────────────────────

# PostgreSQL connection (a superuser role is needed at install time so the
# installer can CREATE DATABASE and set up extensions/triggers).
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=change-me
DB_NAME=actmon

# Organization + admin identity used to seed the baseline tenant.
# The Super Admin employee + user themselves are created in the first-run wizard.
ORG_NAME=Your Company
ADMIN_EMAIL=admin@yourcompany.com

# Security. CHANGE JWT_SECRET before going to production.
JWT_SECRET=change-me-in-production

# AI features (optional) — leave blank to disable.
GROQ_API_KEY=

# SMTP for login OTP + alert emails (optional at install; required for OTP login).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
