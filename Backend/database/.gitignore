# Virtual Environment
venv/
.venv/
env/
ENV/
# Disk-space workaround: pytest installed here via `pip install --target`
# when the venv's own drive had no free space. Run
# `pip install -r requirements.txt` into the real venv instead once space is
# available, then this directory is unnecessary.
.test_deps/

# Python Cache
__pycache__/
*.py[cod]
*$py.class

# Distribution / Packaging
build/
dist/
*.egg-info/
.eggs/

# Logs
*.log

# Environment Variables (ship the template, never the real secrets)
.env
.env.*
!.env.example

# IDE Files
.vscode/
.idea/

# OS Files
.DS_Store
Thumbs.db

# Pytest
.pytest_cache/

# Coverage
.coverage
htmlcov/

# MyPy
.mypy_cache/

# FastAPI Uploads (optional)
uploads/
media/

# SQLite Database (if used)
*.db
*.sqlite3

# Temporary Files
*.tmp
*.temp

# Jupyter Notebook
.ipynb_checkpoints/

# Python Version
.python-version