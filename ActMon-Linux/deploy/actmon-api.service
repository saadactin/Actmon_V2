[Unit]
Description=ActMon API (FastAPI / uvicorn)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=__USER__
WorkingDirectory=__APP_DIR__/backend/database
EnvironmentFile=__APP_DIR__/backend/database/.env
# Single worker is REQUIRED: the agent job-channel (fs-poll / dbquery) is in-process,
# so multiple workers would split poll vs. job across processes and time out. One
# uvicorn worker still serves many concurrent requests (async + threadpool).
ExecStart=__APP_DIR__/venv/bin/uvicorn main:app --host 127.0.0.1 --port __PORT__ --workers 1
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
