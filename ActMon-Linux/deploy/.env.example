# ActMon backend/database/.env
# Copied to $APP_DIR/backend/database/.env by deploy/install.sh (secrets auto-generated
# there). The cloud service (backend/cloud) reads the SAME file via
# EnvironmentFile=-__APP_DIR__/backend/database/.env in its systemd unit.

# ── PostgreSQL (primary datastore) ─────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=actmon
DB_PASS=changeme-strong-password
DB_NAME=actmon
# Alternative to the DB_* fields above — if set, takes precedence:
# DATABASE_URL=postgresql://actmon:changeme-strong-password@127.0.0.1:5432/actmon
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800

# ── Auth / security (install.sh generates real values for these) ──────────
JWT_SECRET=changeme-generate-with-openssl-rand-hex-32
FERNET_KEY=changeme-generate-with-python-cryptography-fernet
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
OTP_ENABLED=true
OTP_TTL_SECONDS=300
OTP_DEBUG=false

# ── Cloud Discovery microservice ───────────────────────────────────────────
CLOUD_SERVICE_PORT=8001
DEBUG=false

# ── Redis (hot metrics tier — optional, degrades to no-op if unreachable) ──
REDIS_URL=redis://127.0.0.1:6379/0
METRICS_RING_SIZE=240
METRICS_PIPELINE_ENABLED=true
METRICS_RETENTION_DAYS=7
METRICS_CH_TTL_DAYS=30

# ── ClickHouse (metrics/log history — optional, actmon_logs degrades if absent) ──
ACTMON_LOGS_ENABLED=false
ACTMON_LOGS_CH_HOST=127.0.0.1
ACTMON_LOGS_CH_PORT=8123
ACTMON_LOGS_CH_USER=default
ACTMON_LOGS_CH_PASSWORD=
ACTMON_LOGS_CH_DB=actmon_logs
ACTMON_LOGS_RETENTION_DAYS=30
ACTMON_LOGS_INTERVAL_SEC=15

# ── Agent collector tuning ─────────────────────────────────────────────────
AGENT_COLLECTOR_INTERVAL=15
SNAPSHOT_INTERVAL_SEC=15
COLLECTOR_ERROR_STREAK=3
AGENT_OFFLINE_SECS=90
AGENT_REMOVE_SECS=2592000

# ── Chatbot (optional AI assistant — leave blank to disable) ──────────────
GROQ_API_KEY=

# ── Installer-only (used once by install/db_setup.py to seed org #1) ──────
ORG_NAME=Default Organization
ADMIN_EMAIL=admin@localhost
